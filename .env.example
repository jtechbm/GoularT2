# Banco — Supabase (Postgres)
# Session pooler (porta 5432) para servidor persistente;
# transaction pooler (porta 6543) para ambientes serverless.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Sessao do sistema (cifra tambem os tokens dos marketplaces)
GOULART_SESSION_SECRET=troque-esta-chave-em-producao

# Mercado Livre (https://developers.mercadolivre.com.br)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:3000/api/integracoes/mercado-livre/callback

# Shopee Open Platform (https://open.shopee.com)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=http://localhost:3000/api/integracoes/shopee/callback
SHOPEE_HOST=https://partner.shopeemobile.com
